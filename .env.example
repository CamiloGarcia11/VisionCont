# ==============================================================================
# GESTIÓN EJECUTIVA Y ADMINISTRATIVA - VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo como `.env.local` y completa los valores reales.
# Nunca subas `.env.local` al repositorio.

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL en Neon
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Auth.js / NextAuth v5 (Acceso con correo y contraseña)
# ------------------------------------------------------------------------------
# Genera uno con: npx auth secret  (o `openssl rand -base64 32`)
AUTH_SECRET="reemplazar-con-secreto-aleatorio-de-32-bytes"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------------------
# 3. Preferencias Regionales por Defecto
# ------------------------------------------------------------------------------
DEFAULT_TIMEZONE="America/Bogota"
DEFAULT_CURRENCY="COP"
